<?xml version="1.0" encoding="utf-8"?>
<!--
  浮层里的输入框底色。

  ⚠️ `state_focused` 必须放在**前面**：selector 自上而下匹配，第一个命中的生效。
  把 default 放前面会让聚焦态永远匹配不到，输入时没有任何视觉反馈 ——
  而「点了输入框但看不出有没有聚焦」在深色壁纸上几乎无法使用。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="10dp" />
            <stroke
                android:width="2dp"
                android:color="#1B7F79" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F5F7FA" />
            <corners android:radius="10dp" />
            <stroke
                android:width="1dp"
                android:color="#E4E7EB" />
        </shape>
    </item>
</selector>
